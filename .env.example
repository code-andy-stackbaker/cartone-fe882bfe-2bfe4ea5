# CartOne — every value below is OPTIONAL. With nothing set, the app runs
# end-to-end on in-memory seed data with the mock payment provider.

# ---- apps/backend ----
# Port to bind. Injected by the platform at deploy; 6000 is the local dev fallback.
PORT=6000
# Comma-separated list of allowed browser origins (the frontend URL).
# Unset => permissive CORS so local dev works with zero config.
ALLOWED_ORIGINS=http://localhost:5000
# Payments provider selector: "mock" (default) or "stripe".
PAYMENTS_PROVIDER=mock
# Stripe secret key — server only. Get one from https://dashboard.stripe.com/test/apikeys
# (use a TEST key, sk_test_...). Required before PAYMENTS_PROVIDER=stripe takes effect.
STRIPE_SECRET_KEY=
# Optional Stripe API base override (used by sandboxes/mocks).
STRIPE_API_BASE=

# ---- apps/frontend (build-time, baked into the bundle by Vite) ----
# Base URL of the backend API. Unset => http://localhost:6000
VITE_BACKEND_URL=http://localhost:6000
# Stripe publishable key — browser safe. https://dashboard.stripe.com/test/apikeys (pk_test_...)
VITE_STRIPE_PUBLISHABLE_KEY=
